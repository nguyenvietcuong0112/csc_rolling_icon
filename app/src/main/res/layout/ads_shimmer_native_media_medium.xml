<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    app:cardCornerRadius="10dp"
    android:background="#51D8BBF6"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <!-- Left Media Container Shimmer -->
        <androidx.cardview.widget.CardView
            android:id="@+id/shimmer_card_media"
            android:layout_width="128dp"
            android:layout_height="0dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lightTransparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Right App Icon Shimmer -->
        <androidx.cardview.widget.CardView
            android:id="@+id/shimmer_card_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lightTransparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/shimmer_card_media" />

        <!-- Headline Line Shimmer -->
        <View
            android:id="@+id/shimmer_headline"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:background="@color/lightTransparent"
            app:layout_constraintTop_toTopOf="@id/shimmer_card_icon"
            app:layout_constraintBottom_toBottomOf="@id/shimmer_card_icon"
            app:layout_constraintStart_toEndOf="@id/shimmer_card_icon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Description/Body Line 1 Shimmer -->
        <View
            android:id="@+id/shimmer_body_line1"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:background="@color/lightTransparent"
            app:layout_constraintTop_toBottomOf="@id/shimmer_card_icon"
            app:layout_constraintStart_toStartOf="@id/shimmer_card_icon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Description/Body Line 2 Shimmer -->
        <View
            android:id="@+id/shimmer_body_line2"
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:background="@color/lightTransparent"
            app:layout_constraintTop_toBottomOf="@id/shimmer_body_line1"
            app:layout_constraintStart_toStartOf="@id/shimmer_card_icon" />

        <!-- Action Button (CTA) Shimmer -->
        <View
            android:id="@+id/shimmer_button_cta"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@color/lightTransparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/shimmer_card_icon"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
